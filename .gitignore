# --- Heavy/reproducible data files under dataset/ ---
dataset/**/*.parquet
dataset/**/*.csv
dataset/**/*.jsonl
dataset/**/*.xlsx
dataset/**/*.xls
dataset/**/*.png
dataset/**/code_repo/
**/.cache/

# --- Secrets (never commit) ---
kaggle.json
.env
.env.*
!.env.example
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
backend/.venv/
backend/dist/
backend/build/

# --- Feature-folder local data + large artifacts (LLM modeling, ideas #01–#05) ---
# keep code, README, small configs & figures; ignore data copies + big indexes
*/data/*.parquet
*/data/*.csv
*/outputs/*.parquet
*/outputs/*.csv
*/models/*.npy
*/models/*.npz
*/models/*.faiss
*/models/*.pkl.big

# Trained model weights — regenerated by training, never reviewed as a diff, and
# large enough to hurt every clone (#08's fine-tuned XLM-R alone is 1.1 GB).
*/outputs/**/*.safetensors
*/outputs/**/*.bin
*/outputs/**/*.h5
*/outputs/**/*.onnx
*/outputs/*.pkl
*/outputs/*.joblib
# The fine-tuned model folder as a whole: without the weights above, its
# tokenizer/config files load nothing, so shipping 16 MB of them buys nobody
# anything. Rebuild by re-running the training notebook.
social_trend/outputs/xlmr_sentiment/

# --- Customer Segmentation (#13): local docs/exports, not pushed ---
customer_segmentation/docs/
customer_segmentation/outputs/

# --- Node ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/dist/
frontend/coverage/
frontend/qa-*.mjs
qa-artifacts/

# --- Ad-hoc local QA output ---
test_result.json

