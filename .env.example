# =====================================================================
# Root-level env template. Variables consumed by docker-compose.yml.
# Copy to `.env` at the repo root. Never commit `.env`.
# =====================================================================

# Ports exposed on the host
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000

# Postgres credentials used by docker compose + backend
POSTGRES_USER=area303
POSTGRES_PASSWORD=area303
POSTGRES_DB=area303

# The backend reads its full config from backend/.env (see backend/.env.example).
# docker-compose passes those values through to the backend container.

# =====================================================================
# LLM modeling layer (ideas #01-#05) — read by common/llm_client.py
# Primary backend is OpenAI; Ollama is an optional local fallback.
# =====================================================================

# openai | ollama
LLM_BACKEND=openai
LLM_CACHE=1
LLM_WORKERS=8

# --- OpenAI (primary) ---
# NEVER put a real key here. This is a committed template — fill your real key
# in the gitignored .env only. The previously leaked key MUST be revoked.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Ollama Cloud ---
# Create a separate key at ollama.com/settings/keys. Never reuse OPENAI_API_KEY.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_CHAT_MODEL=gpt-oss:120b
OLLAMA_EMBED_MODEL=bge-m3

# Seller Autopilot (backend/.env is authoritative when running FastAPI).
AUTOPILOT_OLLAMA_URL=https://ollama.com
AUTOPILOT_OLLAMA_MODEL=gpt-oss:120b
AUTOPILOT_LLM_TIMEOUT_SECONDS=60
