# =====================================================================
# AREA 303 — Backend environment template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

# ---------- App ----------
APP_NAME="AREA-303 API"
APP_ENV=development           # development | staging | production | test
AREA303_DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated origins for CORS. Add the frontend dev server here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Postgres ----------
POSTGRES_HOST=localhost
# Must match the host port docker-compose publishes (root .env POSTGRES_PORT).
# Use something other than 5432 if you already run Postgres locally.
POSTGRES_PORT=5432
POSTGRES_USER=area303
POSTGRES_PASSWORD=area303
POSTGRES_DB=area303
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---------- Auth / JWT ----------
# Override in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- Observability ----------
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
# SENTRY_DSN=

# ---------- Pagination ----------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---------- GenAI ----------
# Demo mode — when true, all GenAI endpoints return pre-generated fixtures.
# This is the safety net for quota exhaustion and offline demos.
DEMO_MODE=true

# LLM provider — gemini | openai | mock.  mock = no real calls.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM response cache TTL (seconds).
LLM_CACHE_TTL_SECONDS=600
LLM_REQUEST_TIMEOUT_SECONDS=15

# Seller Autopilot: real Ollama Cloud API. Create a key at ollama.com/settings/keys.
OLLAMA_API_KEY=
AUTOPILOT_OLLAMA_URL=https://ollama.com
AUTOPILOT_OLLAMA_MODEL=gpt-oss:120b
AUTOPILOT_LLM_TIMEOUT_SECONDS=60

# Rate limit per IP per minute on /api/v1/* GenAI routes.
RATE_LIMIT_PER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=300
# Set true only behind a trusted reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ---------- RAG / Vector store ----------
PINECONE_API_KEY=
PINECONE_INDEX=area303-tiki-catalog
PINECONE_ENVIRONMENT=
VECTOR_BACKEND=memory   # pinecone | faiss | memory
EMBEDDING_MODEL=text-embedding-3-small

# ---------- SSE ----------
SSE_HEARTBEAT_SECONDS=15

# --- Competitor tracking: where sales figures come from ---
# Followers / rating / product count need nothing here — Shopee's get_shop_base
# answers anonymously. Units sold, GMV, best sellers and promotions do NOT: every
# endpoint carrying them returns error 90309999 to an anonymous caller, and the
# shop page renders a login wall even in a real browser (verified Aug 2026).
# Leave both blocks unset and the panel shows shop-level metrics only, and says so.

# 1. Licensed market-data feed (Metric.vn, BeeCost, ...). No account risk.
#    Tried first when set. GET {base}/shops/{platform}/{shop_ref} + Bearer key.
COMPETITOR_VENDOR_BASE_URL=
COMPETITOR_VENDOR_API_KEY=

# 2. A logged-in Shopee session.
#    IN THE PRODUCT each user connects their OWN Shopee account and nothing here
#    is involved: they run `python scripts/shopee_connect.py --email <their email>`,
#    log in inside their own browser, and only the cookie jar is uploaded — their
#    Shopee password never reaches this app, which is what keeps 2FA/OTP working.
#    Sessions are stored per user, encrypted with CREDENTIAL_ENCRYPTION_KEY below.
#
#    The two settings below are the SINGLE-TENANT DEV FALLBACK: one operator-wide
#    session file, captured with `shopee_connect.py --save-to var/shopee_session.json`.
#    WARNING either way: Shopee's terms prohibit automated access, so a connected
#    account can be rate-limited or banned. Prefer a secondary account.
COMPETITOR_USE_SESSION=false
COMPETITOR_SESSION_PATH=var/shopee_session.json

# Fernet key encrypting users' connected Shopee sessions at rest. Without it the
# connect endpoint REFUSES to store anything rather than falling back to
# plaintext — a stolen jar is full access to that person's Shopee account.
# Separate from JWT_SECRET so rotating one doesn't force rotating the other.
#   python -c "from app.core.crypto import generate_key; print(generate_key())"
CREDENTIAL_ENCRYPTION_KEY=

# Best sellers read per capture. A trend reading, not a catalogue crawl.
COMPETITOR_TOP_N=20
