# Frontend → backend wiring. Copy to `.env.local` (gitignored).
# Base URL of the FastAPI backend (see docker-compose / backend/README).
# Browser gọi cùng origin; Next.js proxy request sang FastAPI. Cấu hình này hoạt
# động trên localhost, iPhone/Android trong LAN và Expo WebView mà không hardcode
# địa chỉ backend vào bundle phía client.
NEXT_PUBLIC_API_URL=/api/v1

# Chỉ Next.js server đọc URL này. Đổi port nếu FastAPI chạy ở port khác.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# "true" forces pre-generated demo data and never calls the backend.
NEXT_PUBLIC_DEMO_MODE=false
